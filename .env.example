# Copy this file to .env and change the values before deploying.

# Port the server listens on
PORT=3000

# Secret used to sign session cookies. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Default admin account created the first time the server starts
# (only if no admin account exists yet). Change the password immediately after first login.
DEFAULT_ADMIN_EMAIL=admin@gpchanumangarh.ac.in
DEFAULT_ADMIN_PASSWORD=ChangeMe@123

# Cookie is marked "secure" (HTTPS-only) when this is "true".
# Set to true once you deploy behind HTTPS.
COOKIE_SECURE=false
